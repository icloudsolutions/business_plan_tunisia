# --- Required in production ---
APP_ENV=development
JWT_SECRET=change_me_to_a_long_random_string_min_32_chars
ADMIN_API_KEY=change_me_admin_key_for_expert_provisioning

# --- Database ---
POSTGRES_USER=bp_user
POSTGRES_PASSWORD=bp_secret_change_me
POSTGRES_DB=business_plan
DATABASE_URL=postgresql+asyncpg://bp_user:bp_secret_change_me@postgres:5432/business_plan

# --- Redis / Celery ---
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

# --- API ---
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440
DISCOUNT_RATE=0.10
CORS_ORIGINS=http://localhost:8088,http://127.0.0.1:8088

# Host ports (80/443 often taken on shared servers)
NGINX_HTTP_PORT=8088
NGINX_HTTPS_PORT=8443

# Expert auto-assigned when client submits a plan (optional; else first expert in DB)
ASSIGN_EXPERT_EMAIL=expert@demo.tn

# Demo seed (clients + experts) — disable in production
RUN_SEED=false
RUN_MIGRATIONS=false
EXPORT_STORAGE_PATH=/app/exports

# --- Claude AI (field assist + executive summary; mock replies if unset) ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-20250514

# --- Transactional email (log | smtp | resend) ---
EMAIL_PROVIDER=log
EMAIL_FROM=Business Plan Tunisie <noreply@businessplan.tn>
APP_BASE_URL=http://localhost:8088
# Resend (if EMAIL_PROVIDER=resend)
RESEND_API_KEY=
# SMTP (if EMAIL_PROVIDER=smtp)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_USE_TLS=true
